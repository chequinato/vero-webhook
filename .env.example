# Connection string do PostgreSQL
VERO_CONNECTION_STRING=Host=localhost;Database=vero;Username=postgres;Password=postgres

# Chave secreta para autenticação HMAC do webhook (gere uma chave forte em produção)
VERO_HMAC_SECRET=sua-chave-secreta-aqui

# Chave de criptografia para dados sensíveis em repouso (gere uma chave forte em produção)
VERO_ENCRYPTION_KEY=sua-chave-criptografia-aqui

# Rate Limiting (opcional — valores padrão: 60 requisições em 60 segundos)
# VERO_RATE_LIMIT_MAX=60
# VERO_RATE_LIMIT_WINDOW=60

# AWS (quando usar SQS/SNS reais)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# VERO_SQS_QUEUE_URL=
# VERO_SNS_TOPIC_ARN=
